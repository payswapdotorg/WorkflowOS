{
  "schemaVersion": 1,
  "unit": "one-work-item-per-branch-pr",
  "requiredContext": [
    "repository",
    "currentMainRevision",
    "workOrder",
    "architectureVersion",
    "dependencies",
    "allowedSurfaces",
    "forbiddenSurfaces",
    "assuranceProfile",
    "checkpointContract",
    "requiredProofs"
  ],
  "workerMay": [
    "inspect-repository",
    "implement-work-order",
    "add-tests",
    "update-work-order-evidence",
    "open-or-update-pr"
  ],
  "workerMayNot": [
    "merge-own-pr",
    "modify-another-work-item-scope",
    "change-governing-architecture-without-acr",
    "bypass-authoritative-domain",
    "invent-second-authority",
    "silently-lower-assurance",
    "treat-conversation-as-source-of-truth"
  ],
  "completionReport": [
    "implementationRevision",
    "changedSurfaces",
    "checksRun",
    "proofResults",
    "knownLimitations",
    "prNumber"
  ],
  "parallelEligibility": "all dependency prerequisites complete AND no uncoordinated protected-surface conflict AND current-base revision matches governance expectation",
  "mergeAuthority": "architect"
}
