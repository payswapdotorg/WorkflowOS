# WorkflowOS deployment environment (WORK-023).
#
# Copy this file to `.env` and fill in real values for your environment.
# Docker Compose reads `.env` automatically (it must be in the repo root).
#
# SECURITY: `.env` is gitignored — never commit real credentials.
#
# For CI, these values are supplied by the deploy workflow's `env:` block
# (see .github/workflows/deploy.yml).

# PostgreSQL credentials (used by the postgres container + the backend).
POSTGRES_USER=wfos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=wfos

# Backend database URL. The credentials MUST match POSTGRES_USER/PASSWORD.
# The host `postgres` resolves to the postgres service in docker-compose.
DATABASE_URL=postgres://wfos:changeme@postgres:5432/wfos

# Redis URL (non-authoritative — queue/locks/cache only).
REDIS_URL=redis://redis:6379

# --- WORK-074: Identity & Access runtime -------------------------------------
# The public origin of the product (used to build the OAuth redirect URIs and
# the session cookie's Secure attribute). Falls back to CORS_ORIGIN when unset.
# WORKFLOWOS_PUBLIC_URL=https://app.example.com
#
# Human login providers (Google OIDC + GitHub OAuth apps). Unconfigured
# providers surface as "unavailable" on the login page (fail closed) — the
# email/password login needs no configuration. The redirect URI to register
# with each provider is: ${WORKFLOWOS_PUBLIC_URL}/api/auth/oauth/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# Server-side session lifetime in seconds (default: 14 days).
# WORKFLOWOS_SESSION_TTL_SECONDS=1209600

# ----------------------------------------------------------------------------
# WORK-071 — Local development runtime (no Docker, no hosted PostgreSQL).
#
# Set WORKFLOWOS_DEV_RUNTIME=pglite (and UNSET DATABASE_URL) to run the
# backend against a local PGlite database: real PostgreSQL compiled to WASM,
# persisted to WORKFLOWOS_DEV_DATABASE_DIR on the local filesystem. The same
# migrations and the same domain code run as production — this is a dev-only
# implementation of the one persistence authority, not a second authority.
#
# Constraints (enforced fail-closed at startup):
#   - MUST NOT be combined with DATABASE_URL (ambiguous database authority).
#   - MUST NOT be used in production (NODE_ENV=production refuses to start).
#
# The dev runtime also substitutes the non-authoritative Redis layer with an
# in-memory stand-in (locks/cache/readiness — Redis never holds
# authoritative state), and the queue with an in-memory queue, so NO
# externally hosted services are required for local development.
# ----------------------------------------------------------------------------
# WORKFLOWOS_DEV_RUNTIME=pglite
# WORKFLOWOS_DEV_DATABASE_DIR=.workflowos-dev-data/pglite
