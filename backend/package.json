{
  "name": "@workflowos/backend",
  "version": "0.1.0",
  "private": true,
  "description": "WorkflowOS TypeScript modular-monolith backend foundation (WORK-001).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch:check": "vitest run tests/architecture",
    "start:api": "tsx src/index.ts --role=api",
    "start:worker": "tsx src/index.ts --role=worker",
    "start": "tsx src/index.ts",
    "governance:status": "tsx src/development-governance/cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.23.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.15.0",
    "ioredis-mock": "^8.9.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
